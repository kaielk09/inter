# INTER — konfiguracja testowa
PORT=3000
PUBLIC_URL=
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
WEBHOOK_SECRET=change-this-to-another-long-random-secret-at-least-32-characters
DATABASE_PATH=./data/inter.sqlite

# false = nie wysyłaj e-maili i nie wymagaj potwierdzenia (tryb testowy)
# true = wymagaj potwierdzenia przez Resend
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
RESEND_FROM=INTER <onboarding@resend.dev>

# Główne API Purple AI — uzupełnij własnymi danymi w prywatnym .env
PURPLE_API_URL=
PURPLE_API_KEY=

WEEKLY_TEST_TOKENS=1000

# Płatności TostHost — pozostaw puste do czasu konfiguracji
TOSTHOST_API_BASE=https://my.tosthost.pl/api/v1
TOSTHOST_API_KEY=
TOSTHOST_SANDBOX=true
PAYMENT_PACKAGES_JSON={}

# App
PORT=3000
PUBLIC_URL=https://twoj-adres-publiczny
JWT_SECRET=change-this-to-a-long-random-secret
WEBHOOK_SECRET=change-this-to-another-long-random-secret
DATABASE_PATH=./data/inter.sqlite

# Email verification via Resend API (no SMTP required)
RESEND_API_KEY=
# Resend test mode sender; only send to the verified recipient address
RESEND_FROM=INTER <onboarding@resend.dev>

# Existing Purple AI API
PURPLE_API_URL=https://twoj-serwer-purple-ai
PURPLE_API_KEY=your_private_server_api_key

WEEKLY_TEST_TOKENS=1000

# TostHost Payments
TOSTHOST_API_BASE=https://my.tosthost.pl/api/v1
TOSTHOST_API_KEY=
TOSTHOST_SANDBOX=false
PAYMENT_PACKAGES_JSON={}

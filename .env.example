# App
PORT=3000
PUBLIC_URL=https://twoja-domena.pl
JWT_SECRET=change-this-to-a-long-random-secret
WEBHOOK_SECRET=change-this-to-another-long-random-secret
DATABASE_PATH=./data/inter.sqlite

# Existing Purple AI API (the shared model API from kaielk09/Ai)
PURPLE_API_URL=https://twoj-serwer-purple-ai
PURPLE_API_KEY=your_private_server_api_key

# Weekly free tester allowance. This is a usage-credit counter, not model training.
WEEKLY_TEST_TOKENS=1000

# Email verification (SMTP) — required for account registration
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# SMTP_USER is the full mailbox address. SMTP_PASS is an app password,
# NOT the normal mailbox password. Keep real credentials only in server secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Purple AI <your-address@gmail.com>

# TostHost Payments
TOSTHOST_API_BASE=https://my.tosthost.pl/api/v1
TOSTHOST_API_KEY=
TOSTHOST_SANDBOX=false

# JSON map of packages. Example structure only; set real prices and credit amounts yourself.
# PAYMENT_PACKAGES_JSON={"small":{"label":"Pakiet mały","amount":5.00,"credits":5000}}
PAYMENT_PACKAGES_JSON={}
